{
  "name": "@my-mimisbrunnr/validation-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {},
  "devDependencies": {},
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "dependsOn": [
          "^build"
        ],
        "options": {
          "outputPath": "packages/validation-service/dist",
          "main": "packages/validation-service/src/index.ts",
          "tsConfig": "packages/validation-service/tsconfig.lib.json"
        }
      },
      "dev": {
        "executor": "@nx/js:node",
        "options": {
          "buildTarget": "@my-mimisbrunnr/validation-service:build",
          "runBuildTargetDependencies": true
        }
      }
    }
  }
}
