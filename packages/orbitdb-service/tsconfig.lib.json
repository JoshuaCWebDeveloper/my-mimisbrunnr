{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "typeRoots": [
      "../../node_modules",
      "../../node_modules/@types",
      "src/@types"
    ]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../shared/orbitdb/tsconfig.lib.json"
    },
    {
      "path": "../shared/validation/tsconfig.lib.json"
    },
    {
      "path": "../shared/protocol/tsconfig.lib.json"
    },
    {
      "path": "../shared/config/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
